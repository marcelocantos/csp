#!/bin/sh
# Ensure dist/ and the development gateway are up to date before committing.

# Only check if source files that affect dist are being committed.
changed_paths=$(git diff --cached --name-only) || exit 1
if printf '%s\n' "$changed_paths" | grep -qE '^(include/|src/|dist/|scripts/amalgamate\.py)'; then
    if ! make dist >/dev/null; then
        echo "ERROR: distribution generation failed."
        exit 1
    fi
    if ! git diff --quiet dist/ include/csp.h; then
        echo "ERROR: generated files are out of date. Run 'make dist' and stage dist/ and include/csp.h."
        echo ""
        git diff --stat dist/ include/csp.h
        exit 1
    fi
fi
